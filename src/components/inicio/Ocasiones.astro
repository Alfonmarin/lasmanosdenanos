---
import { Image } from "astro:assets";
import { tartas } from "../../data/tartas";
import { galletas } from "../../data/galletas";

// Cada mosaico usa la primera creación con foto de su categoría, así que si
// reordenas o añades tartas/galletas se actualiza solo. Los enlaces llevan a
// la sección correspondiente de la galería.
const conFoto = <T extends { foto?: unknown }>(lista: T[]) => lista.filter((x) => x.foto);

const cumple = tartas.filter((t) => t.categoria === "cumpleanos");
const eventos = tartas.filter((t) => t.categoria === "eventos");

const creaciones = (n: number) => `${n} ${n === 1 ? "creación" : "creaciones"}`;

const mosaicos = [
  {
    nombre: "Cumpleaños",
    etiqueta: "Tartas",
    texto: "Temáticas, divertidas y con su nombre",
    href: "/galeria#cumpleanos",
    foto: conFoto(cumple)[0]?.foto,
    total: creaciones(cumple.length),
  },
  {
    nombre: "Eventos",
    etiqueta: "Tartas",
    texto: "Bodas, comuniones, bautizos y más",
    href: "/galeria#eventos",
    foto: conFoto(eventos)[0]?.foto,
    total: creaciones(eventos.length),
  },
  {
    nombre: "Galletas",
    etiqueta: "Dulces",
    texto: "Decoradas a mano para cada ocasión",
    href: "/galeria#galletas",
    foto: conFoto(galletas)[0]?.foto,
    total: creaciones(galletas.length),
  },
];
---

<section class="ocasiones">
  <div class="ocasiones-inner">
    <header class="ocasiones-head" data-reveal>
      <p class="kicker"><span class="line"></span>Para cada ocasión<span class="line"></span></p>
      <h2 class="ocasiones-title">¿Qué celebramos?</h2>
    </header>

    <div class="mosaicos">
      {
        mosaicos.map((m) => (
          <a href={m.href} class="mosaico" data-reveal>
            {m.foto ? (
              <Image
                src={m.foto}
                alt=""
                widths={[400, 700, 1000]}
                sizes="(max-width: 700px) 92vw, 360px"
                class="mosaico-img"
              />
            ) : (
              <span class="mosaico-img vacio" />
            )}
            <span class="mosaico-veil" />
            <span class="mosaico-body">
              <span class="mosaico-chip">{m.etiqueta}</span>
              <span class="mosaico-nombre">{m.nombre}</span>
              <span class="mosaico-texto">{m.texto}</span>
              <span class="mosaico-cta">
                Ver {m.total} <span aria-hidden="true">→</span>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ocasiones {
    background: var(--color-bg-light);
    padding: 80px 5vw 90px;
  }

  .ocasiones-inner {
    max-width: 1160px;
    margin: 0 auto;
  }

  .ocasiones-head {
    text-align: center;
    margin-bottom: 40px;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 10px;
    font-weight: 800;
    font-size: 12.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9769a;
  }

  .line {
    width: 24px;
    height: 1.5px;
    background: #e7b8cb;
  }

  .ocasiones-title {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 400;
    font-size: clamp(34px, 4.4vw, 50px);
    color: var(--color-primary);
  }

  .mosaicos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .mosaico {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: 26px;
    overflow: hidden;
    isolation: isolate;
    box-shadow: 0 26px 50px -30px rgba(120, 30, 70, 0.55);
  }

  .mosaico-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .mosaico-img.vacio {
    background: repeating-linear-gradient(135deg, #f6e1e6 0 16px, #fceef1 16px 32px);
  }

  .mosaico:hover .mosaico-img {
    transform: scale(1.06);
  }

  .mosaico-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(40, 10, 28, 0) 38%,
      rgba(58, 16, 38, 0.82) 100%
    );
  }

  .mosaico-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    color: #fff;
  }

  .mosaico-chip {
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .mosaico-nombre {
    font-family: var(--font-title);
    font-size: 34px;
    line-height: 1.2;
  }

  .mosaico-texto {
    font-weight: 600;
    font-size: 14.5px;
    opacity: 0.9;
  }

  .mosaico-cta {
    margin-top: 10px;
    font-weight: 800;
    font-size: 14px;
    display: inline-flex;
    gap: 6px;
    transition: gap 0.2s ease;
  }
  .mosaico:hover .mosaico-cta {
    gap: 10px;
  }

  @media (max-width: 900px) {
    .mosaicos {
      gap: 14px;
    }
    .mosaico-nombre {
      font-size: 28px;
    }
    .mosaico-body {
      padding: 18px;
    }
  }

  /* En móvil: una columna con mosaicos apaisados, para no hacer un scroll
     eterno con tres fotos verticales */
  @media (max-width: 700px) {
    .ocasiones {
      padding: 56px 16px 60px;
    }
    .ocasiones-head {
      margin-bottom: 26px;
    }
    .mosaicos {
      grid-template-columns: 1fr;
    }
    .mosaico {
      aspect-ratio: 16 / 11;
    }
  }
</style>
