---
import { Image } from "astro:assets";
import nanosImg from "../../assets/sobre-nanos/nanos.jpg";
import { diplomas } from "../../data/diplomas";
---

<section class="historia">
  <div class="historia-inner">
    <div class="historia-foto">
      <Image
        src={nanosImg}
        alt="Elsa, «Nanos», en su cocina"
        widths={[360, 560, 800]}
        sizes="(max-width: 900px) 70vw, 420px"
        class="historia-img"
      />
      <span class="historia-tag">Repostera artesana ♡</span>
    </div>

    <div class="historia-text" data-reveal>
      <p class="kicker"><span class="line"></span>Nuestra historia<span class="line"></span></p>
      <h2 class="historia-title">Hola, soy Elsa</h2>
      <p class="historia-lead">
        En casa siempre me llamaron <strong>Nanos</strong>, y de tanto hornear
        para los míos nació algo más grande: unas manos que endulzan los días
        importantes de otras familias.
      </p>
      <p class="historia-desc">
        Cada tarta sale de mi cocina como salían para los míos: con tiempo, con
        mimo y con la ilusión de que sepa a hecho en casa.
      </p>
      <a href="/sobre-nanos" class="historia-btn">Conóceme</a>
    </div>
  </div>

  <!-- Tira de diplomas en movimiento continuo. La lista va duplicada para que
       el bucle no tenga saltos; la copia está oculta a lectores de pantalla. -->
  <div class="diplomas" aria-label="Formación de Elsa">
    <p class="diplomas-label">Con formación en</p>
    <div class="marquee">
      <div class="marquee-track">
        {
          [0, 1].map((copia) =>
            diplomas.map((d) => (
              <figure class="diploma" aria-hidden={copia === 1 ? "true" : undefined}>
                <Image src={d.imagen} alt="" width={320} class="diploma-img" />
                <figcaption>
                  <span class="diploma-titulo">{d.titulo}</span>
                  <span class="diploma-escuela">{d.escuela}</span>
                </figcaption>
              </figure>
            )),
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .historia {
    background: var(--color-bg-light);
    padding: 90px 0 70px;
    overflow: hidden;
  }

  .historia-inner {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 5vw;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 64px;
    align-items: center;
  }

  /* Foto tipo polaroid, un poco girada */
  .historia-foto {
    position: relative;
    justify-self: center;
    width: min(100%, 400px);
    padding: 14px 14px 18px;
    background: #fff;
    border-radius: 22px;
    transform: rotate(-3deg);
    box-shadow: 0 30px 60px -34px rgba(120, 30, 70, 0.55);
  }

  .historia-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 14px;
  }

  .historia-tag {
    position: absolute;
    right: -14px;
    bottom: 34px;
    transform: rotate(6deg);
    background: #fff;
    color: var(--color-primary);
    font-weight: 800;
    font-size: 13px;
    padding: 9px 15px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    box-shadow: 0 10px 24px -10px rgba(120, 40, 70, 0.4);
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 10px;
    font-weight: 800;
    font-size: 12.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9769a;
  }

  .line {
    width: 24px;
    height: 1.5px;
    background: #e7b8cb;
  }

  .historia-title {
    margin: 0 0 16px;
    font-family: var(--font-title);
    font-weight: 400;
    font-size: clamp(36px, 4.4vw, 52px);
    color: var(--color-primary);
  }

  .historia-lead {
    margin: 0 0 14px;
    font-size: 18px;
    line-height: 1.6;
    font-weight: 600;
    color: var(--color-text-dark);
  }

  .historia-desc {
    margin: 0 0 28px;
    font-size: 16px;
    line-height: 1.6;
    font-weight: 600;
    color: var(--color-text);
  }

  .historia-btn {
    display: inline-flex;
    font-weight: 800;
    font-size: 15px;
    padding: 13px 28px;
    border-radius: 999px;
    color: #8a4e9e;
    background: #fff;
    border: 2px solid #e7d6f1;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .historia-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -12px rgba(138, 78, 158, 0.35);
  }

  /* ---- Diplomas ---- */
  .diplomas {
    margin-top: 80px;
  }

  .diplomas-label {
    text-align: center;
    margin: 0 0 20px;
    font-weight: 800;
    font-size: 12.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #b78aa0;
  }

  .marquee {
    overflow: hidden;
    /* Difumina los bordes para que las tarjetas "entren" y "salgan" suaves */
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    gap: 18px;
    width: max-content;
    padding: 6px 0 20px;
    animation: desliza 55s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  /* La lista está duplicada: al llegar a la mitad vuelve al principio sin salto.
     El -9px compensa medio hueco entre las dos copias. */
  @keyframes desliza {
    to {
      transform: translateX(calc(-50% - 9px));
    }
  }

  .diploma {
    margin: 0;
    width: 250px;
    flex: none;
    background: #fff;
    border-radius: 18px;
    padding: 10px 10px 14px;
    border: 1px solid var(--color-border);
    box-shadow: 0 14px 30px -24px rgba(140, 60, 95, 0.5);
  }

  .diploma-img {
    display: block;
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: 12px;
  }

  .diploma figcaption {
    padding: 10px 4px 0;
  }

  .diploma-titulo {
    display: block;
    font-weight: 800;
    font-size: 14px;
    line-height: 1.3;
    color: var(--color-text-dark);
  }

  .diploma-escuela {
    display: block;
    margin-top: 3px;
    font-weight: 600;
    font-size: 12px;
    color: #8a6a76;
  }

  @media (max-width: 900px) {
    .historia {
      padding: 60px 0 50px;
    }
    .historia-inner {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }
    .historia-foto {
      width: min(78%, 320px);
    }
    .historia-tag {
      right: -8px;
    }
    .historia-lead {
      font-size: 16.5px;
    }
    .diplomas {
      margin-top: 56px;
    }
    .diploma {
      width: 200px;
    }
    .diploma-img {
      height: 120px;
    }
  }

  /* Sin movimiento automático: la tira se desplaza con el dedo/ratón */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
    }
    .marquee-track {
      animation: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const foto = document.querySelector<HTMLElement>(".historia-foto");
  const tag = document.querySelector<HTMLElement>(".historia-tag");
  const reducirMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (foto && tag && !reducirMovimiento) {
    const mm = gsap.matchMedia();

    // Escritorio: la foto entra girando y con rebote; el sello de
    // "repostera artesana" aparece justo después, con un pop achulado.
    mm.add("(min-width: 901px)", () => {
      gsap.set(foto, { opacity: 0, y: 70, rotate: -16, scale: 0.82 });
      gsap.set(tag, { opacity: 0, scale: 0.3, rotate: -22 });

      ScrollTrigger.create({
        trigger: foto,
        start: "top 85%",
        once: true,
        onEnter: () => {
          gsap
            .timeline()
            .to(foto, {
              opacity: 1,
              y: 0,
              rotate: -3,
              scale: 1,
              duration: 0.9,
              ease: "back.out(1.6)",
            })
            .to(
              tag,
              {
                opacity: 1,
                scale: 1,
                rotate: 6,
                duration: 0.7,
                ease: "back.out(3)",
              },
              "-=0.15",
            );
        },
      });
    });

    // Móvil: mismo orden, más discreto (sin el giro exagerado).
    mm.add("(max-width: 900px)", () => {
      gsap.set(foto, { opacity: 0, y: 40 });
      gsap.set(tag, { opacity: 0, scale: 0.4, rotate: -14 });

      ScrollTrigger.create({
        trigger: foto,
        start: "top 88%",
        once: true,
        onEnter: () => {
          gsap
            .timeline()
            .to(foto, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" })
            .to(
              tag,
              { opacity: 1, scale: 1, rotate: 6, duration: 0.6, ease: "back.out(3)" },
              "-=0.1",
            );
        },
      });
    });
  }
</script>
