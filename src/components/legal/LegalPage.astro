---
// Página de texto legal (aviso legal, privacidad, cookies): misma cabecera
// y tipografía para las tres, cada una solo aporta su contenido por el slot.
import Layout from "../../layouts/Layout.astro";

type Props = {
  titulo: string;
  descripcion: string;
  actualizado: string;
};

const { titulo, descripcion, actualizado } = Astro.props;
---

<Layout titulo={titulo} descripcion={descripcion}>
  <section class="legal">
    <div class="legal-inner">
      <a href="/" class="back-link">← Volver al inicio</a>
      <p class="legal-kicker">Las Manos de Nanos</p>
      <h1 class="legal-title">{titulo}</h1>
      <p class="legal-fecha">Última actualización: {actualizado}</p>
      <article class="legal-body">
        <slot />
      </article>
    </div>
  </section>
</Layout>

<style>
  .legal {
    padding: 56px 5vw 90px;
  }

  .legal-inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 800;
    font-size: 14px;
    color: var(--color-secondary);
    margin-bottom: 28px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .legal-kicker {
    margin: 0 0 6px;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .legal-title {
    font-family: var(--font-title);
    font-size: clamp(32px, 5vw, 44px);
    margin: 0 0 10px;
  }

  .legal-fecha {
    margin: 0 0 36px;
    font-size: 13.5px;
    font-weight: 700;
    color: #a88;
  }

  /* ---- Cuerpo del texto: mismas reglas para las tres páginas ---- */
  .legal-body :global(h2) {
    font-size: 19px;
    margin: 36px 0 12px;
  }

  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }

  .legal-body :global(p) {
    margin: 0 0 14px;
    line-height: 1.7;
    font-size: 15.5px;
  }

  .legal-body :global(ul) {
    margin: 0 0 14px;
    padding-left: 22px;
    line-height: 1.7;
    font-size: 15.5px;
  }

  .legal-body :global(li) {
    margin-bottom: 4px;
  }

  .legal-body :global(a) {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-body :global(strong) {
    color: var(--color-text-dark);
  }

  @media (max-width: 600px) {
    .legal {
      padding: 40px 6vw 70px;
    }
  }
</style>
