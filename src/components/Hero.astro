---
import { CONTACTO } from "../data/contacto";

// Vídeo de fondo: clip gratuito de Mixkit (licencia libre para uso comercial,
// sin atribución). Para cambiarlo, sustituye los archivos de public/video/
// manteniendo los nombres: el de escritorio, uno ligero para móvil y una
// imagen fija (poster) que se ve mientras carga o si el vídeo no se reproduce.
const VIDEO_ESCRITORIO = "/video/hero-reposteria.mp4";
const VIDEO_MOVIL = "/video/hero-reposteria-movil.mp4";
const VIDEO_POSTER = "/video/hero-reposteria-poster.jpg";

// Palabras que van rotando en el titular ("…para tu cumpleaños", "…para tu boda")
const ocasiones = [
  "cumpleaños",
  "boda",
  "comunión",
  "graduación",
  "baby shower",
  "bautizo",
];

const perks = [
  { emoji: "🎨", title: "Diseño a medida", sub: "lo pensamos juntas" },
  { emoji: "🤲", title: "Hecho a mano", sub: "en mi cocina, sin prisas" },
  { emoji: "📅", title: "Reserva con tiempo", sub: `mín. ${CONTACTO.plazoMinimoTexto} antes` },
  { emoji: "📍", title: "Entrega o recogida", sub: "consulta tu zona" },
];
---

<section class="hero">
  <div class="hero-media">
    <video
      class="hero-video"
      data-src-escritorio={VIDEO_ESCRITORIO}
      data-src-movil={VIDEO_MOVIL}
      poster={VIDEO_POSTER}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"></video>
    <div class="hero-veil"></div>
  </div>

  <div class="hero-inner">
    <div class="hero-content">
      <p class="hero-kicker">
        <span class="line"></span>Repostería artesanal<span class="line"></span>
      </p>

      <h1 class="hero-title">
        <span class="hero-title-main">Tartas hechas a mano</span>
        <span class="hero-title-sub">
          para tu{" "}<span
            class="hero-typed"
            data-palabras={JSON.stringify(ocasiones)}
            aria-live="off">{ocasiones[0]}</span
          ><span class="hero-caret" aria-hidden="true"></span>
        </span>
      </h1>

      <p class="hero-lead">
        Tartas, galletas y dulces personalizados para que tu celebración sepa a
        hecho en casa.
      </p>

      <div class="hero-actions">
        <a href="/contacto" class="hero-btn primary">Encarga tu tarta</a>
        <a href="/galeria" class="hero-btn ghost">Ver galería</a>
      </div>
    </div>
  </div>

  <ul class="hero-perks">
    {
      perks.map((p) => (
        <li class="perk">
          <span class="perk-icon" aria-hidden="true">{p.emoji}</span>
          <span class="perk-text">
            <span class="perk-title">{p.title}</span>
            <span class="perk-sub">{p.sub}</span>
          </span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .hero {
    position: relative;
    background: #2a1420;
    isolation: isolate;
  }

  /* ---- Vídeo de fondo ---- */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Velo para que el texto se lea: más oscuro a la izquierda (donde va el
     texto) y con un toque rosado de la marca */
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        rgba(58, 16, 38, 0.86) 0%,
        rgba(90, 20, 55, 0.62) 42%,
        rgba(188, 17, 80, 0.18) 100%
      ),
      linear-gradient(180deg, rgba(0, 0, 0, 0) 60%, rgba(40, 10, 28, 0.55) 100%);
  }

  /* ---- Contenido ---- */
  .hero-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 5vw;
    min-height: clamp(560px, calc(100svh - 78px), 820px);
    display: flex;
    align-items: center;
    padding-bottom: 120px; /* hueco para la franja de ventajas */
  }

  .hero-content {
    max-width: 640px;
    color: #fff;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    font-weight: 800;
    font-size: 12.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #f7c3d6;
  }

  .line {
    width: 24px;
    height: 1.5px;
    background: #f7c3d6;
    opacity: 0.7;
  }

  .hero-title {
    margin: 0 0 20px;
    color: #fff;
    font-weight: 400;
  }

  .hero-title-main {
    display: block;
    font-family: var(--font-title);
    font-size: clamp(44px, 6.4vw, 82px);
    line-height: 1.12;
    text-wrap: balance;
    text-shadow: 0 6px 30px rgba(0, 0, 0, 0.25);
  }

  .hero-title-sub {
    display: block;
    margin-top: 10px;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(22px, 2.6vw, 32px);
    color: #fde6ee;
  }

  .hero-typed {
    color: #ff9cc0;
  }

  .hero-caret {
    display: inline-block;
    width: 3px;
    height: 0.95em;
    margin-left: 3px;
    vertical-align: -0.12em;
    background: #ff9cc0;
    border-radius: 2px;
    animation: parpadeo 1s steps(1) infinite;
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  .hero-lead {
    margin: 0 0 30px;
    max-width: 480px;
    font-size: 18px;
    line-height: 1.6;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.88);
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 16px;
    padding: 15px 30px;
    border-radius: 999px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }
  .hero-btn:hover {
    transform: translateY(-2px);
  }

  .hero-btn.primary {
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 16px 34px -14px rgba(188, 17, 80, 0.9);
  }

  .hero-btn.ghost {
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(4px);
  }
  .hero-btn.ghost:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  /* ---- Franja de ventajas (sobre el vídeo en escritorio) ---- */
  .hero-perks {
    list-style: none;
    margin: 0;
    position: absolute;
    left: 50%;
    bottom: 34px;
    transform: translateX(-50%);
    width: min(1160px, 100%);
    padding: 0 5vw;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .perk {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(8px);
    color: #fff;
  }

  .perk-icon {
    flex: none;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.16);
  }

  .perk-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .perk-title {
    font-weight: 800;
    font-size: 14.5px;
  }

  .perk-sub {
    font-weight: 600;
    font-size: 12.5px;
    opacity: 0.8;
    margin-top: 2px;
  }

  /* ---- Tablet ---- */
  @media (max-width: 1000px) {
    .hero-perks {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-inner {
      padding-bottom: 190px;
    }
  }

  /* ---- Móvil: texto centrado y ventajas en una franja clara bajo el vídeo ---- */
  @media (max-width: 700px) {
    .hero-veil {
      background: linear-gradient(
        180deg,
        rgba(58, 16, 38, 0.55) 0%,
        rgba(70, 18, 45, 0.78) 100%
      );
    }
    .hero-inner {
      min-height: calc(100svh - 150px);
      padding: 48px 20px 44px;
      justify-content: center;
      text-align: center;
    }
    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .hero-lead {
      font-size: 16px;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 340px;
    }
    .hero-perks {
      position: static;
      transform: none;
      background: var(--color-bg-light);
      padding: 18px 16px;
      gap: 10px;
    }
    .perk {
      flex-direction: column;
      text-align: center;
      gap: 8px;
      padding: 14px 10px;
      background: #fff;
      border-color: var(--color-border);
      backdrop-filter: none;
      color: var(--color-text-dark);
      box-shadow: 0 12px 26px -20px rgba(140, 60, 95, 0.45);
    }
    .perk-icon {
      background: #fceff1;
    }
    .perk-sub {
      color: #8a6a76;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-caret {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const reducirMovimiento = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  // --- Vídeo: elegimos la versión según el ancho y solo lo reproducimos
  // mientras se ve (ahorra batería y datos). Con "reducir movimiento" se
  // queda la imagen fija.
  const video = document.querySelector<HTMLVideoElement>(".hero-video");
  if (video && !reducirMovimiento) {
    const esMovil = window.matchMedia("(max-width: 700px)").matches;
    video.src = (esMovil ? video.dataset.srcMovil : video.dataset.srcEscritorio) ?? "";
    new IntersectionObserver(([entrada]) => {
      if (entrada.isIntersecting) video.play().catch(() => {});
      else video.pause();
    }).observe(video);
  }

  // --- Texto que se escribe solo: "para tu cumpleaños / boda / comunión…"
  const typed = document.querySelector<HTMLElement>(".hero-typed");
  if (typed && !reducirMovimiento) {
    const palabras: string[] = JSON.parse(typed.dataset.palabras ?? "[]");
    let i = 0;
    const esperar = (ms: number) => new Promise((r) => setTimeout(r, ms));

    (async function ciclo() {
      while (true) {
        await esperar(2000);
        const actual = palabras[i];
        for (let n = actual.length; n >= 0; n--) {
          typed.textContent = actual.slice(0, n);
          await esperar(45);
        }
        i = (i + 1) % palabras.length;
        const siguiente = palabras[i];
        await esperar(200);
        for (let n = 1; n <= siguiente.length; n++) {
          typed.textContent = siguiente.slice(0, n);
          await esperar(85);
        }
      }
    })();
  }

  // --- Entrada
  if (!reducirMovimiento) {
    gsap.from(".hero-content > *", {
      y: 28,
      opacity: 0,
      duration: 0.8,
      stagger: 0.12,
      ease: "power3.out",
      delay: 0.1,
    });
    gsap.from(".hero-perks .perk", {
      y: 24,
      opacity: 0,
      duration: 0.6,
      stagger: 0.08,
      ease: "power2.out",
      delay: 0.6,
    });
  }
</script>
