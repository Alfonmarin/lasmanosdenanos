---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PedidoWizard from "../components/PedidoWizard.astro";
import logoImg from "../assets/logo.png";
import { CONTACTO, waLink, igLink, mailLink } from "../data/contacto";

const perks = [
  {
    emoji: "⏱️",
    title: "Respuesta rápida",
    sub: "en pocas horas",
    variant: "pink",
  },
  {
    emoji: "📍",
    title: "Entrega y recogida",
    sub: "consulta tu zona",
    variant: "purple",
  },
  {
    emoji: "📅",
    title: "Reserva con tiempo",
    sub: `mín. ${CONTACTO.plazoMinimoTexto} antes`,
    variant: "pink",
  },
];

const chatMessages = [
  { from: "in", text: "¡Hola! Quiero una tarta para el cumple de mi hija 🎂" },
  {
    from: "out",
    text: "¡Qué ilusión! ¿Para cuántas personas y qué temática? ✨",
  },
  { from: "in", text: "Somos 12 y le encantan los unicornios 🦄" },
  { from: "out", text: "¡Me encanta! Te preparo una propuesta 💖" },
];

const pasos = [
  "Me escribes con tu idea y la fecha.",
  "Te paso propuesta y presupuesto.",
  "Confirmas y me pongo manos a la obra.",
];
---

<Layout>
  <!-- === HERO === -->
  <section class="contacto-hero">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="subtitle-bar">
          <span class="line"></span>Contacto<span class="line"></span>
        </div>
        <h1 class="hero-title">Hablemos de tu idea</h1>
        <p class="hero-lead">
          Cuéntame qué celebras y lo diseñamos juntas. La forma más rápida es
          WhatsApp: te respondo personalmente en pocas horas.
        </p>
        <div class="hero-actions">
          <a href={waLink} target="_blank" rel="noopener" class="btn-whatsapp">
            <span class="dot-white"></span>Escríbeme por WhatsApp
          </a>
          <a href={igLink} target="_blank" rel="noopener" class="btn-instagram">
            @{CONTACTO.instagramHandle}
          </a>
        </div>
        <div class="perks-row">
          {
            perks.map((perk) => (
              <div class="perk">
                <span class={`perk-icon ${perk.variant}`}>{perk.emoji}</span>
                <div>
                  <div class="perk-title">{perk.title}</div>
                  <div class="perk-sub">{perk.sub}</div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="chat-mock">
        <div class="chat-header">
          <Image
            src={logoImg}
            alt=""
            width={76}
            height={76}
            class="chat-avatar"
          />
          <div>
            <div class="chat-name">Las Manos de Nanos</div>
            <div class="chat-status">en línea · te responde Elsa</div>
          </div>
        </div>
        <div class="chat-body">
          {
            chatMessages.map((msg) => (
              <div class:list={["chat-bubble", msg.from]}>{msg.text}</div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- === SCALLOPED DIVIDER === -->
  <div class="scalloped"></div>

  <!-- === CANALES + FORMULARIO === -->
  <section class="channels-section">
    <div class="channels-inner">
      <!-- CANALES -->
      <div class="channels-col">
        <h2 class="channels-title">Por dónde quieras</h2>
        <p class="channels-lead">
          Elige tu canal favorito. Sea cual sea, te responde Elsa en persona.
        </p>

        <a href={waLink} target="_blank" rel="noopener" class="channel-card">
          <span class="channel-icon green">💬</span>
          <div class="channel-info">
            <div class="channel-name">WhatsApp</div>
            <div class="channel-detail">{CONTACTO.whatsappDisplay}</div>
          </div>
          <span class="channel-arrow green">→</span>
        </a>

        <a href={igLink} target="_blank" rel="noopener" class="channel-card">
          <span class="channel-icon pink">📸</span>
          <div class="channel-info">
            <div class="channel-name">Instagram</div>
            <div class="channel-detail">@{CONTACTO.instagramHandle}</div>
          </div>
          <span class="channel-arrow pink">→</span>
        </a>

        <a href={mailLink} class="channel-card">
          <span class="channel-icon rose">✉️</span>
          <div class="channel-info">
            <div class="channel-name">Email</div>
            <div class="channel-detail">{CONTACTO.email}</div>
          </div>
          <span class="channel-arrow rose">→</span>
        </a>

        <div class="how-card">
          <div class="how-title">Cómo funciona</div>
          <div class="how-steps">
            {
              pasos.map((paso, i) => (
                <div class="how-step">
                  <span class="how-num">{i + 1}</span>
                  <span class="how-text">{paso}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- FORMULARIO -->
      <PedidoWizard />
    </div>
  </section>
</Layout>

<style>
  /* ---- HERO ---- */
  .contacto-hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(120% 90% at 22% -10%, #fceef0 0%, #fffaf4 62%);
  }

  .hero-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 58px 5vw 56px;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 52px;
    align-items: center;
  }

  .subtitle-bar {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9769a;
    margin-bottom: 16px;
  }

  .line {
    width: 24px;
    height: 1.5px;
    background: #e7b8cb;
  }

  .hero-title {
    font-family: var(--font-title);
    font-size: clamp(38px, 6vw, 54px);
    line-height: 1.12;
    color: var(--color-primary);
    margin: 0 0 16px;
  }

  .hero-lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text);
    font-weight: 600;
    margin: 0 0 28px;
    max-width: 460px;
  }

  .hero-actions {
    display: flex;
    gap: 13px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .btn-whatsapp {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25d366;
    color: #fff;
    font-weight: 800;
    font-size: 16px;
    padding: 15px 26px;
    border-radius: 999px;
    box-shadow: 0 14px 30px -12px rgba(37, 211, 102, 0.55);
    transition: transform 0.2s ease;
  }
  .btn-whatsapp:hover {
    transform: translateY(-2px);
  }

  .dot-white {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
  }

  .btn-instagram {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: #fff;
    color: #8a4e9e;
    font-weight: 800;
    font-size: 16px;
    padding: 14px 24px;
    border-radius: 999px;
    border: 2px solid #e7d6f1;
    transition: transform 0.2s ease;
  }
  .btn-instagram:hover {
    transform: translateY(-2px);
  }

  .perks-row {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
  }

  .perk {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .perk-icon {
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
  }
  .perk-icon.pink {
    background: #fceff1;
  }
  .perk-icon.purple {
    background: #f6ecfb;
  }

  .perk-title {
    font-weight: 800;
    font-size: 13.5px;
    color: var(--color-text-dark);
  }

  .perk-sub {
    font-weight: 600;
    font-size: 12.5px;
    color: #8a6a76;
    margin-top: 2px;
  }

  /* ---- CHAT MOCK ---- */
  .chat-mock {
    justify-self: center;
    width: 340px;
    max-width: 100%;
    background: #fff;
    border-radius: 26px;
    box-shadow: 0 30px 60px -28px rgba(140, 60, 95, 0.5);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 14px 18px;
    background: #128c7e;
    color: #fff;
  }

  .chat-avatar {
    width: 38px;
    height: 38px;
    object-fit: cover;
    border-radius: 50%;
    background: #fff;
    padding: 3px;
  }

  .chat-name {
    font-weight: 800;
    font-size: 15px;
  }

  .chat-status {
    font-size: 11.5px;
    opacity: 0.85;
  }

  .chat-body {
    padding: 20px 16px;
    background: linear-gradient(180deg, #fbeff3, #f7ecf0);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .chat-bubble {
    max-width: 82%;
    padding: 11px 14px;
    font-size: 13.5px;
    line-height: 1.45;
    font-weight: 600;
    box-shadow: 0 4px 10px -6px rgba(0, 0, 0, 0.15);
  }

  .chat-bubble.in {
    align-self: flex-start;
    background: #fff;
    color: var(--color-text-dark);
    border-radius: 14px 14px 14px 4px;
  }

  .chat-bubble.out {
    align-self: flex-end;
    background: #dcf8c6;
    color: #33502b;
    border-radius: 14px 14px 4px 14px;
  }

  /* ---- SCALLOPED ---- */
  .scalloped {
    height: 26px;
    background:
      radial-gradient(circle at 13px 0, #f6ecfb 13px, transparent 14px) 0 0/26px
        26px repeat-x,
      #fffaf4;
  }

  /* ---- CHANNELS + FORM ---- */
  .channels-section {
    background: #f6ecfb;
    padding: 56px 5vw;
  }

  .channels-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 32px;
    align-items: start;
  }

  .channels-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .channels-title {
    font-family: var(--font-title);
    font-size: 30px;
    color: #8a4e9e;
    margin: 0 0 4px;
  }

  .channels-lead {
    margin: 0 0 6px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-secondary);
    font-weight: 600;
  }

  .channel-card {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 15px;
    background: #fff;
    border-radius: 18px;
    padding: 18px 20px;
    box-shadow: 0 14px 34px -22px rgba(140, 60, 95, 0.4);
    border: 1px solid #ede1f3;
    transition: transform 0.2s ease;
  }

  .channel-card:not(.static):hover {
    transform: translateY(-2px);
  }

  .channel-icon {
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }
  .channel-icon.green {
    background: #e9f9ee;
  }
  .channel-icon.pink {
    background: #fbeaf3;
  }
  .channel-icon.rose {
    background: #fceff1;
  }

  .channel-info {
    flex: 1;
  }

  .channel-name {
    font-weight: 800;
    font-size: 16px;
    color: var(--color-text-dark);
  }

  .channel-detail {
    font-weight: 600;
    font-size: 13.5px;
    color: #8a6a76;
    margin-top: 2px;
  }

  .channel-arrow {
    font-weight: 800;
    font-size: 20px;
  }
  .channel-arrow.green {
    color: #25a653;
  }
  .channel-arrow.pink {
    color: #c13584;
  }
  .channel-arrow.rose {
    color: var(--color-primary);
  }

  .how-card {
    background: #fff;
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 14px 34px -22px rgba(140, 60, 95, 0.4);
    border: 1px solid #ede1f3;
  }

  .how-title {
    font-weight: 800;
    font-size: 14px;
    color: var(--color-text-dark);
    margin-bottom: 10px;
  }

  .how-steps {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .how-step {
    display: flex;
    gap: 11px;
    align-items: flex-start;
  }

  .how-num {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fceff1;
    color: var(--color-primary);
    font-weight: 800;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .how-text {
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--color-secondary);
    font-weight: 600;
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      padding: 44px 5vw 40px;
    }
    .chat-mock {
      width: 100%;
    }
    .channels-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-whatsapp,
    .btn-instagram {
      justify-content: center;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  // --- Entrance animations ---
  gsap.from(".hero-text > *", {
    y: 24,
    opacity: 0,
    duration: 0.7,
    stagger: 0.12,
    ease: "power2.out",
  });

  gsap.from(".chat-mock", {
    y: 24,
    opacity: 0,
    duration: 0.7,
    ease: "power2.out",
    delay: 0.2,
  });

  gsap.from(".channel-card, .how-card", {
    y: 16,
    opacity: 0,
    duration: 0.5,
    stagger: 0.08,
    ease: "power2.out",
  });

  gsap.from(".wizard", {
    y: 20,
    opacity: 0,
    duration: 0.6,
    ease: "power2.out",
    delay: 0.15,
  });
</script>
