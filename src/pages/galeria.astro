---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import { tartas, tieneFicha, ULTIMA_NOVEDAD_ID } from "../data/tartas";

const cumpleanosTartas = tartas.filter((t) => t.categoria === "cumpleanos");
const eventosTartas = tartas.filter((t) => t.categoria === "eventos");

// Igual que en src/data/tartas.ts: añade `foto: miImportacion` a un item
// para poner una imagen real (importa el archivo desde src/assets/galeria/
// arriba del todo del archivo). Sin `foto` se muestra el patrón de relleno.
const galletas: {
  id: string;
  nombre: string;
  desc: string;
  foto?: ImageMetadata;
}[] = [
  {
    id: "galleta-1",
    nombre: "Galletas decoradas",
    desc: "De mantequilla con glasa real, pintadas a mano una a una.",
  },
  {
    id: "galleta-2",
    nombre: "Galletas personalizadas",
    desc: "Con nombres, logos o la forma que imagines para tu detalle.",
  },
  {
    id: "galleta-3",
    nombre: "Caja surtida de mini galletas",
    desc: "Un puñado de sabores caseros para regalar o compartir.",
  },
];

// Se elige a mano vía ULTIMA_NOVEDAD_ID (en src/data/tartas.ts), nunca por
// orden automático — así una tarta sin modelo 3D no puede colarse aquí.
// El fallback solo entra en juego si ese id no existe o se queda sin modelo.
const ultimaNovedad =
  tartas.find((t) => t.id === ULTIMA_NOVEDAD_ID && t.modelo) ??
  tartas.find((t) => t.modelo)!;

const CATEGORIA_LABEL = { cumpleanos: "Cumpleaños", eventos: "Eventos" } as const;

const cumpleanosLabel = `${cumpleanosTartas.length} ${cumpleanosTartas.length === 1 ? "creación" : "creaciones"}`;
const eventosLabel = `${eventosTartas.length} ${eventosTartas.length === 1 ? "creación" : "creaciones"}`;
const galletasLabel = `${galletas.length} ${galletas.length === 1 ? "creación" : "creaciones"}`;
---

<Layout>
  <!-- === HERO: GALERÍA + ÚLTIMA NOVEDAD === -->
  <section class="galeria-hero">
    <div class="hero-blob a"></div>
    <div class="hero-blob b"></div>
    <div class="confetti c1"></div>
    <div class="confetti c2"></div>
    <div class="confetti c3"></div>

    <div class="hero-inner">
      <div class="hero-top">
        <div class="subtitle-bar">
          <span class="line"></span>Nuestras creaciones
        </div>
        <h1 class="hero-title">Galería</h1>
        <p class="hero-lead">
          Cada tarta se piensa contigo y se hornea a mano. Explora por ocasión
          y descubre las que puedes girar en 3D.
        </p>
      </div>

      <div class="hero-stage">
        <div class="hero-pedestal"></div>
        <model-viewer
          src={ultimaNovedad.modelo}
          alt={ultimaNovedad.nombre}
          camera-controls
          auto-rotate
          auto-rotate-delay="0"
          rotation-per-second="18deg"
          interaction-prompt="none"
          camera-orbit="0deg 80deg auto"
          min-camera-orbit="auto 10deg auto"
          max-camera-orbit="auto 90deg auto"
          shadow-intensity="1"
          exposure="0.95"
          style="width: 100%; height: 100%; background: transparent;"
        />
        <span class="pill-3d">↺ 360°</span>
      </div>

      <div class="hero-feature">
        <span class="badge-novedad"
          ><span class="badge-dot"></span>Última novedad</span
        >
        <h2 class="feature-name">{ultimaNovedad.nombre}</h2>
        <p class="feature-desc">{ultimaNovedad.desc}</p>
        <div class="feature-chips">
          <span class="chip">{CATEGORIA_LABEL[ultimaNovedad.categoria]}</span>
          <span class="chip">Personalizable</span>
        </div>
        <div class="feature-actions">
          <a href={`/galeria/${ultimaNovedad.id}`} class="btn-feature">
            Ver detalles →
          </a>
          <a href="#creaciones" class="link-explore" id="link-explore">
            Ver todas las creaciones ↓
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- === SCALLOPED DIVIDER === -->
  <div class="scalloped"></div>

  <!-- === CATEGORY SECTIONS === -->
  <div class="categories-wrapper" id="creaciones">
    <!-- CUMPLEAÑOS -->
    <section class="category-section">
      <div class="section-header">
        <h2 class="section-title primary">Cumpleaños</h2>
        <span class="section-line pink"></span>
        <span class="section-count">{cumpleanosLabel}</span>
      </div>
      <div class="cards-grid">
        {
          cumpleanosTartas.map((item) => {
            const conFicha = tieneFicha(item);
            const Wrapper = conFicha ? "a" : "div";
            return (
              <Wrapper
                href={conFicha ? `/galeria/${item.id}` : undefined}
                class="card"
              >
                <div class="card-img primary">
                  {item.foto ? (
                    <Image src={item.foto} alt={item.nombre} class="card-photo" />
                  ) : (
                    <span class="img-label">Foto · Tarta</span>
                  )}
                  <span class="pill-cat primary">Cumpleaños</span>
                </div>
                <div class="card-body">
                  <h3 class="card-name">{item.nombre}</h3>
                  <p class="card-text">{item.desc}</p>
                  {conFicha ? (
                    <span class="card-cta">Ver detalles →</span>
                  ) : (
                    <a href="/contacto" class="card-cta">
                      Contacto →
                    </a>
                  )}
                </div>
              </Wrapper>
            );
          })
        }
      </div>
    </section>

    <!-- EVENTOS -->
    <section class="category-section">
      <div class="section-header">
        <h2 class="section-title secondary">Eventos</h2>
        <span class="section-line purple"></span>
        <span class="section-count secondary">{eventosLabel}</span>
      </div>
      <div class="cards-grid">
        {
          eventosTartas.map((item) => {
            const conFicha = tieneFicha(item);
            const Wrapper = conFicha ? "a" : "div";
            return (
              <Wrapper
                href={conFicha ? `/galeria/${item.id}` : undefined}
                class="card"
              >
                <div class="card-img secondary">
                  {item.foto ? (
                    <Image src={item.foto} alt={item.nombre} class="card-photo" />
                  ) : (
                    <span class="img-label purple">Foto · Tarta</span>
                  )}
                  <span class="pill-cat secondary">Eventos</span>
                </div>
                <div class="card-body">
                  <h3 class="card-name">{item.nombre}</h3>
                  <p class="card-text">{item.desc}</p>
                  {conFicha ? (
                    <span class="card-cta">Ver detalles →</span>
                  ) : (
                    <a href="/contacto" class="card-cta">
                      Contacto →
                    </a>
                  )}
                </div>
              </Wrapper>
            );
          })
        }
      </div>
    </section>

    <!-- GALLETAS -->
    <section class="category-section">
      <div class="section-header">
        <h2 class="section-title primary">Galletas</h2>
        <span class="section-line pink"></span>
        <span class="section-count">{galletasLabel}</span>
      </div>
      <div class="cards-grid">
        {
          galletas.map((item) => (
            <div class="card">
              <div class="card-img primary">
                {item.foto ? (
                  <Image src={item.foto} alt={item.nombre} class="card-photo" />
                ) : (
                  <span class="img-label">Foto · Galletas</span>
                )}
                <span class="pill-cat primary">Galletas</span>
              </div>
              <div class="card-body">
                <h3 class="card-name">{item.nombre}</h3>
                <p class="card-text">{item.desc}</p>
                <a href="/contacto" class="card-cta">
                  Contacto →
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <!-- === FOOTER CTA === -->
  <section class="footer-cta">
    <div class="cta-dot t"></div>
    <div class="cta-dot b"></div>
    <h2 class="cta-title">¿Ya tienes tu idea en mente?</h2>
    <p class="cta-desc">
      Cuéntanos qué celebras y la diseñamos juntas. Te respondemos rápido.
    </p>
    <div class="cta-actions">
      <a href="/contacto" class="cta-btn-main">
        <span class="dot-green"></span>Escríbenos por WhatsApp
      </a>
      <a
        href="https://instagram.com"
        target="_blank"
        rel="noopener"
        class="cta-btn-outline"
      >
        Síguenos en Instagram
      </a>
    </div>
  </section>
</Layout>

<style>
  /* ---- HERO ---- */
  .galeria-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(80% 60% at 78% 35%, #f1e3fa 0%, rgba(241, 227, 250, 0) 62%),
      radial-gradient(70% 55% at 12% 15%, #fde8ee 0%, rgba(253, 232, 238, 0) 60%),
      linear-gradient(180deg, #fffaf4 0%, #fbeff3 100%);
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(48px);
    opacity: 0.75;
    pointer-events: none;
  }
  .hero-blob.a {
    width: 380px;
    height: 380px;
    top: 6%;
    right: 8%;
    background: #e6d0f7;
  }
  .hero-blob.b {
    width: 300px;
    height: 300px;
    bottom: -6%;
    right: 30%;
    background: #fbd0dd;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1160px;
    margin: 0 auto;
    padding: 56px 5vw 64px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    grid-template-areas:
      "top stage"
      "feature stage";
    column-gap: 48px;
    align-items: center;
  }

  .hero-top {
    grid-area: top;
    align-self: end;
    padding-bottom: 22px;
    margin-bottom: 22px;
    border-bottom: 1.5px solid rgba(188, 17, 80, 0.12);
  }

  .subtitle-bar {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9769a;
  }

  .line {
    width: 22px;
    height: 1.5px;
    background: #e7b8cb;
  }

  .hero-title {
    font-family: var(--font-title);
    font-size: clamp(40px, 5vw, 52px);
    line-height: 1.1;
    color: var(--color-primary);
    margin: 10px 0;
  }

  .hero-lead {
    max-width: 440px;
    margin: 0;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--color-text);
    font-weight: 600;
  }

  /* Stage: la tarta 3D flotando sin caja */
  .hero-stage {
    grid-area: stage;
    position: relative;
    height: 540px;
  }

  .hero-pedestal {
    position: absolute;
    left: 50%;
    bottom: 9%;
    width: 64%;
    height: 46px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(140, 60, 110, 0.26) 0%,
      rgba(140, 60, 110, 0) 70%
    );
    filter: blur(6px);
    pointer-events: none;
  }

  .hero-stage model-viewer {
    position: relative;
    z-index: 1;
  }

  .hero-stage .pill-3d {
    top: auto;
    right: auto;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  /* Feature: la novedad destacada */
  .hero-feature {
    grid-area: feature;
    align-self: start;
  }

  .badge-novedad {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #eadbf6;
    color: #7b4fae;
    font-weight: 800;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #7b4fae;
  }

  .feature-name {
    font-family: var(--font-body);
    font-weight: 900;
    font-size: clamp(30px, 3.4vw, 40px);
    letter-spacing: -0.01em;
    line-height: 1.12;
    color: var(--color-text-dark);
    margin: 4px 0 10px;
  }

  .feature-desc {
    margin: 0;
    max-width: 460px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-text);
    font-weight: 600;
  }

  .feature-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid #f1d6dd;
    color: #8a4e9e;
    font-weight: 800;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 11px;
    border-radius: 999px;
  }

  .feature-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 24px;
  }

  .btn-feature {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-primary);
    color: #fff;
    font-weight: 800;
    font-size: 15px;
    padding: 14px 24px;
    border-radius: 999px;
    box-shadow: 0 14px 30px -12px rgba(188, 17, 80, 0.55);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .btn-feature:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 34px -12px rgba(188, 17, 80, 0.6);
  }

  .link-explore {
    color: #8a4e9e;
    font-weight: 800;
    font-size: 14px;
    transition: color 0.2s ease;
  }
  .link-explore:hover {
    color: var(--color-primary);
  }

  /* Confetti */
  .confetti {
    position: absolute;
    border-radius: 3px;
    z-index: 1;
  }
  .c1 {
    top: 14%;
    left: 6vw;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #f4cbd8;
  }
  .c2 {
    top: 12%;
    right: 7vw;
    width: 16px;
    height: 6px;
    background: #c9aee6;
    transform: rotate(-32deg);
  }
  .c3 {
    bottom: 14%;
    left: 40vw;
    width: 15px;
    height: 6px;
    background: #e7b8cb;
    transform: rotate(22deg);
  }

  /* ---- SCALLOPED ---- */
  .scalloped {
    height: 26px;
    background:
      radial-gradient(circle at 13px 0, #fbeff3 13px, transparent 14px) 0 0/26px
        26px repeat-x,
      #fffaf4;
  }

  /* ---- CATEGORIES ---- */
  .categories-wrapper {
    max-width: 1160px;
    margin: 0 auto;
    padding: 12px 5vw 20px;
  }

  .category-section {
    padding: 34px 0 12px;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .section-title {
    font-family: var(--font-title);
    font-size: 32px;
    margin: 0;
  }
  .section-title.primary {
    color: var(--color-primary);
  }
  .section-title.secondary {
    color: #8a4e9e;
  }

  .section-line {
    height: 1.5px;
    flex: 1;
  }
  .section-line.pink {
    background: linear-gradient(90deg, #f1d6dd, transparent);
  }
  .section-line.purple {
    background: linear-gradient(90deg, #e7d6f1, transparent);
  }

  .section-count {
    font-weight: 800;
    font-size: 13px;
    color: #c67f9b;
    white-space: nowrap;
  }
  .section-count.secondary {
    color: #a07ec0;
  }

  /* ---- CARDS ---- */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .card {
    display: block;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 14px 34px -20px rgba(140, 60, 95, 0.4);
    border: 1px solid #f3e1e5;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 42px -16px rgba(140, 60, 95, 0.5);
  }

  .card.secondary {
    border-color: #ede1f3;
  }

  .card-img {
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-img.primary {
    background: repeating-linear-gradient(
      135deg,
      #f6e1e6 0 15px,
      #fceef1 15px 30px
    );
  }

  .card-img.secondary {
    background: repeating-linear-gradient(
      135deg,
      #eee2f5 0 15px,
      #f7effb 15px 30px
    );
  }

  .img-label {
    font:
      800 11px/1.6 ui-monospace,
      Menlo,
      monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #be7c92;
  }

  .img-label.purple {
    color: #a886c4;
  }

  .pill-cat {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(255, 255, 255, 0.92);
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 9px;
    border-radius: 999px;
  }
  .pill-cat.primary {
    color: #8a4e9e;
  }
  .pill-cat.secondary {
    color: #8a4e9e;
  }

  .pill-3d {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #7b4fae;
    color: #fff;
    font-weight: 800;
    font-size: 10.5px;
    padding: 6px 10px;
    border-radius: 999px;
    box-shadow: 0 6px 14px -6px rgba(123, 79, 174, 0.6);
  }

  .card-body {
    padding: 18px 20px 20px;
  }

  .card-name {
    margin: 0 0 6px;
    font-weight: 800;
    font-size: 18px;
    color: var(--color-text-dark);
  }

  .card-text {
    margin: 0 0 14px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-secondary);
    font-weight: 600;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary);
    font-weight: 800;
    font-size: 13.5px;
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .card:hover .card-cta {
    gap: 10px;
  }

  /* ---- FOOTER CTA ---- */
  .footer-cta {
    position: relative;
    overflow: hidden;
    margin-top: 20px;
    padding: 56px 5vw;
    text-align: center;
    background: linear-gradient(135deg, #bc1150 0%, #9c1257 100%);
    color: #fff;
  }

  .cta-dot {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
  }
  .cta-dot.t {
    top: 34px;
    left: 12vw;
    width: 12px;
    height: 12px;
  }
  .cta-dot.b {
    bottom: 40px;
    right: 14vw;
    width: 16px;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.3);
    transform: rotate(24deg);
  }

  .cta-title {
    font-family: var(--font-title);
    font-size: clamp(28px, 5vw, 38px);
    margin: 0 0 10px;
    color: #fff;
  }

  .cta-desc {
    max-width: 520px;
    margin: 0 auto 26px;
    font-size: 17px;
    line-height: 1.55;
    color: #fce0ea;
    font-weight: 600;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .cta-btn-main {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: #fff;
    color: var(--color-primary);
    font-weight: 800;
    font-size: 16px;
    padding: 15px 28px;
    border-radius: 999px;
    box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease;
  }
  .cta-btn-main:hover {
    transform: translateY(-2px);
  }

  .dot-green {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #25d366;
  }

  .cta-btn-outline {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: #fff;
    font-weight: 800;
    font-size: 16px;
    padding: 14px 26px;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    transition: background 0.2s ease;
  }
  .cta-btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 900px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        "top"
        "stage"
        "feature";
      column-gap: 0;
      padding: 44px 5vw 52px;
      text-align: center;
    }
    .hero-top {
      align-self: auto;
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: 8px;
    }
    .hero-lead,
    .feature-desc {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-stage {
      height: 400px;
    }
    .hero-feature {
      align-self: auto;
      margin-top: 26px;
    }
    .feature-chips,
    .feature-actions {
      justify-content: center;
    }
    .hero-blob.a {
      width: 260px;
      height: 260px;
      top: 22%;
      right: -10%;
    }
    .hero-blob.b {
      width: 220px;
      height: 220px;
      right: auto;
      left: -10%;
      bottom: 20%;
    }
  }

  @media (max-width: 600px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
    .hero-stage {
      height: 320px;
    }
    .hero-pedestal {
      width: 72%;
    }
    .feature-actions {
      flex-direction: column;
      gap: 12px;
    }
    .btn-feature {
      width: 100%;
      justify-content: center;
    }
    .categories-wrapper {
      padding: 12px 20px 20px;
    }
    .section-title {
      font-size: 26px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import "@google/model-viewer";

  // --- 3D viewer: volver a la posición inicial tras un rato sin tocar ---
  const RESET_DELAY_MS = 1500;
  document.querySelectorAll<any>("model-viewer").forEach((mv) => {
    let resetTimer: ReturnType<typeof setTimeout>;
    mv.addEventListener("camera-change", (event: CustomEvent) => {
      if (event.detail.source !== "user-interaction") return;
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        mv.cameraOrbit = "auto auto auto";
        mv.fieldOfView = "auto";
      }, RESET_DELAY_MS);
    });
  });

  // --- Scroll suave al enlace "Ver todas las creaciones" ---
  document.getElementById("link-explore")?.addEventListener("click", (e) => {
    e.preventDefault();
    document
      .getElementById("creaciones")
      ?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // --- Entrance animations on page load ---
  gsap.from(".hero-blob", { opacity: 0, duration: 1.4, ease: "power1.out" });

  gsap.from(".hero-top > *, .hero-feature > *", {
    y: 22,
    opacity: 0,
    duration: 0.7,
    stagger: 0.09,
    ease: "power2.out",
  });

  gsap.from(".hero-stage", {
    y: 26,
    opacity: 0,
    scale: 0.94,
    duration: 1,
    ease: "power3.out",
    delay: 0.25,
  });
</script>
