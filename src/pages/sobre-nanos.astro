---
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import elsaImg from "../assets/sobre-nanos/nanos.jpg";
import { diplomas } from "../data/diplomas";

const stats = [
  { valor: "+8", label: "años horneando" },
  { valor: "+200", label: "encargos felices" },
  { valor: "100%", label: "hecho a mano" },
];

// Versión grande (optimizada a WebP) de cada diploma para la vista ampliada.
const diplomasFull = await Promise.all(
  diplomas.map((d) => getImage({ src: d.imagen, width: 2000, format: "webp" })),
);

const metaDe = (d: (typeof diplomas)[number]) =>
  [d.escuela, d.fecha].filter(Boolean).join(" · ");
---

<Layout>
  <!-- === HERO: RETRATO + INTRO === -->
  <section class="nanos-hero">
    <div class="hero-inner">
      <div class="portrait-wrap">
        <div class="portrait-backdrop"></div>
        <div class="portrait">
          <Image
            src={elsaImg}
            alt="Elsa, Nanos"
            width={640}
            height={800}
            class="portrait-img"
          />
        </div>
        <span class="portrait-tag">Repostera artesana ♡</span>
      </div>

      <div class="intro">
        <div class="subtitle-bar">
          <span class="line"></span>Sobre Nanos<span class="line"></span>
        </div>
        <h1 class="hero-title">Hola, soy Elsa</h1>
        <p class="hero-lead">
          En casa siempre me llamaron <strong>Nanos</strong>, y de tanto
          hornear para los míos nació algo más grande: unas manos que
          endulzan los días importantes de otras familias.
        </p>
        <p class="hero-desc">
          Cada tarta, cada cupcake y cada galleta sale de mi cocina como
          salían para los míos: con tiempo, con mimo y con la ilusión de que
          sepa a hecho en casa.
        </p>
        <div class="stats-row">
          {
            stats.map((stat, i) => (
              <>
                {i > 0 && <span class="stat-divider" />}
                <div class="stat">
                  <div class="stat-valor">{stat.valor}</div>
                  <div class="stat-label">{stat.label}</div>
                </div>
              </>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- === SCALLOPED DIVIDER === -->
  <div class="scalloped scalloped-to-quote"></div>

  <!-- === PULL QUOTE === -->
  <section class="quote-section">
    <div class="quote-dot q1"></div>
    <div class="quote-dot q2"></div>
    <div class="quote-card">
      <span class="quote-mark open">&ldquo;</span>
      <p class="quote-text">
        No vendo tartas: vendo el momento en que todos sonríen antes de
        soplar las velas.
      </p>
      <span class="quote-mark close">&rdquo;</span>
      <div class="quote-divider"></div>
      <p class="quote-author">Elsa, «Nanos»</p>
    </div>
  </section>

  <!-- === SCALLOPED DIVIDER === -->
  <div class="scalloped scalloped-to-diplomas"></div>

  <!-- === DIPLOMAS Y CERTIFICACIONES === -->
  <section class="diplomas-section">
    <div class="diplomas-inner">
      <div class="section-header-center">
        <div class="subtitle-bar">
          <span class="line"></span>Con formación<span class="line"></span>
        </div>
        <h2 class="section-title">Diplomas y certificaciones</h2>
        <p class="section-subtitle">
          Cariño casero, sí, pero también técnica. Estos son algunos de mis
          cursos y certificados — pulsa en cualquiera para verlo en grande.
        </p>
      </div>

      <div class="diplomas-grid">
        {
          diplomas.map((diploma, i) => (
            <button
              type="button"
              class="diploma-card"
              data-index={i}
              data-full={diplomasFull[i].src}
              data-titulo={diploma.titulo}
              data-meta={metaDe(diploma)}
              aria-label={`Ver en grande: ${diploma.titulo}`}
            >
              <div class="diploma-img">
                <Image
                  src={diploma.imagen}
                  alt=""
                  width={640}
                  class="diploma-thumb"
                />
                <span class="diploma-zoom" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                    <circle cx="11" cy="11" r="7" />
                    <path d="M20 20l-3.5-3.5M11 8v6M8 11h6" />
                  </svg>
                </span>
              </div>
              <div class="diploma-body">
                <span class="diploma-tipo">{diploma.tipo}</span>
                <h3 class="diploma-titulo">{diploma.titulo}</h3>
                <p class="diploma-fuente">{metaDe(diploma)}</p>
              </div>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- === VISOR AMPLIADO DE DIPLOMAS === -->
  <dialog id="diploma-dialog" class="lightbox" aria-label="Diploma ampliado">
    <button type="button" class="lb-close" aria-label="Cerrar">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <div class="lb-content">
      <figure class="lb-figure">
        <img id="lb-img" class="lb-img" alt="" />
      </figure>
      <div class="lb-bar">
        <button type="button" class="lb-nav" data-dir="-1" aria-label="Diploma anterior">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 5l-7 7 7 7" />
          </svg>
        </button>
        <div class="lb-caption">
          <span id="lb-count" class="lb-count"></span>
          <span id="lb-title" class="lb-title"></span>
          <span id="lb-meta" class="lb-meta"></span>
        </div>
        <button type="button" class="lb-nav" data-dir="1" aria-label="Diploma siguiente">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </dialog>

  <!-- === FOOTER CTA === -->
  <section class="footer-cta">
    <div class="cta-dot t"></div>
    <div class="cta-dot b"></div>
    <h2 class="cta-title">¿Hacemos tu tarta juntas?</h2>
    <p class="cta-desc">
      Cuéntame qué celebras y le pongo todo el cariño. Te respondo por
      WhatsApp.
    </p>
    <div class="cta-actions">
      <a href="/contacto" class="cta-btn-main">
        <span class="dot-green"></span>Escríbeme por WhatsApp
      </a>
      <a href="/galeria" class="cta-btn-outline"> Ver la galería </a>
    </div>
  </section>
</Layout>

<style>
  /* ---- HERO ---- */
  .nanos-hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(120% 90% at 78% -10%, #fceef0 0%, #fffaf4 62%);
  }

  .hero-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 58px 5vw 56px;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 56px;
    align-items: center;
  }

  .portrait-wrap {
    position: relative;
    justify-self: center;
  }

  .portrait-backdrop {
    position: absolute;
    inset: -14px -14px 18px -14px;
    border-radius: 200px 200px 26px 26px;
    background: #f6ecfb;
    transform: rotate(-3deg);
  }

  .portrait {
    position: relative;
    width: 320px;
    height: 400px;
    max-width: 70vw;
    border-radius: 190px 190px 22px 22px;
    overflow: hidden;
    box-shadow: 0 26px 50px -24px rgba(140, 60, 95, 0.5);
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .portrait-tag {
    position: absolute;
    bottom: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: #fff;
    color: var(--color-primary);
    font-weight: 800;
    font-size: 13px;
    padding: 10px 18px;
    border-radius: 999px;
    box-shadow: 0 12px 26px -12px rgba(120, 40, 70, 0.4);
    border: 1px solid #f3dde3;
    white-space: nowrap;
  }

  .subtitle-bar {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9769a;
    margin-bottom: 16px;
  }

  .line {
    width: 22px;
    height: 1.5px;
    background: #e7b8cb;
  }

  .hero-title {
    font-family: var(--font-title);
    font-size: clamp(38px, 6vw, 56px);
    line-height: 1.12;
    color: var(--color-primary);
    margin: 0 0 18px;
  }

  .hero-lead {
    font-size: 19px;
    line-height: 1.65;
    color: var(--color-text);
    font-weight: 600;
    margin: 0 0 16px;
  }

  .hero-lead strong {
    color: var(--color-primary);
  }

  .hero-desc {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--color-secondary);
    font-weight: 500;
    margin: 0;
  }

  .stats-row {
    display: flex;
    gap: 34px;
    margin-top: 30px;
    flex-wrap: wrap;
    align-items: center;
  }

  .stat-divider {
    width: 1px;
    align-self: stretch;
    background: #f1d6dd;
  }

  .stat-valor {
    font-family: var(--font-title);
    font-size: 30px;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-label {
    font-weight: 700;
    font-size: 13px;
    color: #8a6a76;
    margin-top: 6px;
  }

  .section-header-center {
    text-align: center;
    margin-bottom: 44px;
  }

  .section-title {
    font-family: var(--font-title);
    font-size: 38px;
    color: var(--color-primary);
    margin: 0 0 10px;
  }

  .section-subtitle {
    max-width: 520px;
    margin: 0 auto;
    font-size: 16px;
    color: var(--color-secondary);
    font-weight: 600;
  }

  /* ---- SCALLOPED ---- */
  .scalloped {
    height: 26px;
  }

  .scalloped-to-quote {
    background:
      radial-gradient(circle at 13px 0, #fbeaee 13px, transparent 14px) 0 0/26px
        26px repeat-x,
      #fffaf4;
  }

  .scalloped-to-diplomas {
    background:
      radial-gradient(circle at 13px 0, #fffaf4 13px, transparent 14px) 0 0/26px
        26px repeat-x,
      #fbeaee;
  }

  /* ---- PULL QUOTE ---- */
  .quote-section {
    position: relative;
    overflow: hidden;
    background: #fbeaee;
    padding: 68px 5vw;
    text-align: center;
  }

  .quote-dot {
    position: absolute;
    border-radius: 50%;
    background: rgba(188, 17, 80, 0.14);
  }
  .quote-dot.q1 {
    top: 36px;
    left: 9vw;
    width: 13px;
    height: 13px;
  }
  .quote-dot.q2 {
    bottom: 44px;
    right: 10vw;
    width: 10px;
    height: 10px;
  }

  .quote-card {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
    background: #fff;
    border-radius: 28px;
    padding: 52px 44px 38px;
    box-shadow: 0 22px 48px -26px rgba(140, 60, 95, 0.45);
    border: 1px solid #f3dde3;
  }

  .quote-mark {
    display: block;
    font-family: var(--font-title);
    font-size: 54px;
    color: #f1d6dd;
    line-height: 0.6;
  }

  .quote-mark.open {
    text-align: left;
  }

  .quote-mark.close {
    text-align: right;
  }

  .quote-text {
    font-family: var(--font-title);
    font-size: 28px;
    line-height: 1.45;
    color: var(--color-primary);
    margin: 8px 0;
  }

  .quote-divider {
    width: 40px;
    height: 2px;
    background: #f1d6dd;
    margin: 20px auto 14px;
  }

  .quote-author {
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8a6a76;
    margin: 0;
  }

  /* ---- DIPLOMAS ---- */
  .diplomas-section {
    background: #fffaf4;
    padding: 58px 5vw;
  }

  .diplomas-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  /* Flex en vez de grid para que la última fila (7 = 4 + 3) quede centrada */
  .diplomas-grid {
    --cols: 4;
    --gap: 22px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
  }

  .diploma-card {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
    display: flex;
    flex-direction: column;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: zoom-in;
    background: #fff;
    border-radius: 16px;
    padding: 12px;
    box-shadow: 0 16px 38px -22px rgba(140, 60, 95, 0.4);
    border: 1px solid var(--color-border);
    /* `translate` (y no `transform`) para no pisarse con la animación de
       entrada de GSAP, que anima `transform`. */
    transition:
      translate 0.25s ease,
      box-shadow 0.25s ease;
  }

  .diploma-card:hover {
    translate: 0 -4px;
    box-shadow: 0 22px 44px -20px rgba(140, 60, 95, 0.5);
  }

  .diploma-card:focus-visible {
    outline: 3px solid rgba(188, 17, 80, 0.45);
    outline-offset: 3px;
  }

  .diploma-img {
    position: relative;
    aspect-ratio: 1.41 / 1;
    border-radius: 10px;
    overflow: hidden;
    background: #f7efe9;
  }

  .diploma-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .diploma-card:hover .diploma-thumb {
    transform: scale(1.05);
  }

  .diploma-zoom {
    position: absolute;
    right: 8px;
    bottom: 8px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-primary);
    box-shadow: 0 6px 14px -6px rgba(120, 40, 70, 0.5);
    transition: transform 0.2s ease;
  }

  .diploma-card:hover .diploma-zoom {
    transform: scale(1.1);
  }

  .diploma-body {
    padding: 12px 4px 4px;
  }

  .diploma-tipo {
    display: block;
    font-weight: 800;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a07ec0;
    margin-bottom: 4px;
  }

  .diploma-titulo {
    margin: 0 0 4px;
    font-weight: 800;
    font-size: 15px;
    color: var(--color-text-dark);
    line-height: 1.3;
  }

  .diploma-fuente {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.4;
    color: #8a6a76;
    font-weight: 600;
  }

  /* ---- VISOR AMPLIADO ---- */
  .lightbox {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox::backdrop {
    background: rgba(38, 18, 28, 0.84);
    backdrop-filter: blur(4px);
  }

  .lightbox[open] .lb-content {
    animation: lb-in 0.28s ease-out;
  }

  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .lb-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 64px 24px 24px;
    max-width: 100%;
  }

  .lb-figure {
    margin: 0;
  }

  .lb-img {
    display: block;
    max-width: min(92vw, 1100px);
    max-height: calc(100vh - 210px);
    max-height: calc(100dvh - 210px);
    width: auto;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.6);
    background: #fff;
    transition: opacity 0.18s ease;
  }

  .lb-img.is-swapping {
    opacity: 0;
  }

  .lb-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    width: min(92vw, 720px);
  }

  .lb-caption {
    flex: 1;
    text-align: center;
    color: #fff;
    min-width: 0;
  }

  .lb-title {
    display: block;
    font-weight: 800;
    font-size: 17px;
    line-height: 1.3;
  }

  .lb-meta {
    display: block;
    margin-top: 4px;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.72);
  }

  .lb-count {
    display: block;
    margin-bottom: 4px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.55);
  }

  .lb-nav,
  .lb-close {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .lb-nav:hover,
  .lb-close:hover {
    background: rgba(255, 255, 255, 0.26);
  }

  .lb-nav:active,
  .lb-close:active {
    transform: scale(0.94);
  }

  .lb-close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
  }

  /* ---- FOOTER CTA ---- */
  .footer-cta {
    position: relative;
    overflow: hidden;
    padding: 56px 5vw;
    text-align: center;
    background: linear-gradient(135deg, #bc1150 0%, #9c1257 100%);
    color: #fff;
  }

  .cta-dot {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
  }
  .cta-dot.t {
    top: 34px;
    left: 12vw;
    width: 12px;
    height: 12px;
  }
  .cta-dot.b {
    bottom: 40px;
    right: 14vw;
    width: 16px;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.3);
    transform: rotate(24deg);
  }

  .cta-title {
    font-family: var(--font-title);
    font-size: clamp(28px, 5vw, 38px);
    margin: 0 0 10px;
    color: #fff;
  }

  .cta-desc {
    max-width: 520px;
    margin: 0 auto 26px;
    font-size: 17px;
    line-height: 1.55;
    color: #fce0ea;
    font-weight: 600;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .cta-btn-main {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: #fff;
    color: var(--color-primary);
    font-weight: 800;
    font-size: 16px;
    padding: 15px 28px;
    border-radius: 999px;
    box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease;
  }
  .cta-btn-main:hover {
    transform: translateY(-2px);
  }

  .dot-green {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #25d366;
  }

  .cta-btn-outline {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: #fff;
    font-weight: 800;
    font-size: 16px;
    padding: 14px 26px;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    transition: background 0.2s ease;
  }
  .cta-btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 44px 5vw 40px;
    }
    .portrait-wrap {
      margin: 0 auto;
    }
    .stats-row {
      justify-content: center;
    }
    .diplomas-grid {
      --cols: 3;
    }
  }

  @media (max-width: 700px) {
    .diplomas-grid {
      --cols: 2;
      --gap: 14px;
    }
  }

  @media (max-width: 600px) {
    .diploma-card {
      padding: 8px;
      border-radius: 14px;
    }
    .diploma-body {
      padding: 10px 2px 2px;
    }
    .diploma-tipo {
      font-size: 9.5px;
    }
    .diploma-titulo {
      font-size: 13.5px;
    }
    .diploma-fuente {
      font-size: 11.5px;
    }
    .diploma-zoom {
      width: 26px;
      height: 26px;
      right: 6px;
      bottom: 6px;
    }
    .lb-content {
      padding: 64px 12px 18px;
      gap: 14px;
    }
    .lb-img {
      max-width: 94vw;
      border-radius: 8px;
    }
    .lb-bar {
      gap: 10px;
      width: 94vw;
    }
    .lb-title {
      font-size: 15px;
    }
    .lb-meta {
      font-size: 12px;
    }
    .lb-nav {
      width: 42px;
      height: 42px;
    }
    .quote-card {
      padding: 40px 24px 30px;
    }
    .quote-text {
      font-size: 24px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  gsap.from(".hero-inner > *", {
    y: 24,
    opacity: 0,
    duration: 0.7,
    stagger: 0.15,
    ease: "power2.out",
  });

  gsap.from(".quote-card", {
    y: 20,
    opacity: 0,
    duration: 0.6,
    ease: "power2.out",
    delay: 0.1,
  });

  gsap.from(".diploma-card", {
    y: 20,
    opacity: 0,
    duration: 0.6,
    stagger: 0.08,
    ease: "power2.out",
    delay: 0.2,
  });

  // --- Visor ampliado de diplomas ---
  const dialog = document.querySelector<HTMLDialogElement>("#diploma-dialog")!;
  const img = document.querySelector<HTMLImageElement>("#lb-img")!;
  const titleEl = document.querySelector<HTMLElement>("#lb-title")!;
  const metaEl = document.querySelector<HTMLElement>("#lb-meta")!;
  const countEl = document.querySelector<HTMLElement>("#lb-count")!;
  const cards = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".diploma-card"),
  );
  let current = 0;
  let lastFocused: HTMLElement | null = null;

  function render(index: number) {
    current = (index + cards.length) % cards.length;
    const card = cards[current];
    const { full = "", titulo = "", meta = "" } = card.dataset;
    img.classList.add("is-swapping");
    const swap = () => {
      img.src = full;
      img.alt = titulo;
      titleEl.textContent = titulo;
      metaEl.textContent = meta;
      countEl.textContent = `${current + 1} / ${cards.length}`;
      img.onload = () => img.classList.remove("is-swapping");
      if (img.complete) img.classList.remove("is-swapping");
    };
    // Al abrir no hay imagen previa que desvanecer; al navegar sí.
    dialog.open ? setTimeout(swap, 150) : swap();
    // Precarga los vecinos para que la navegación sea instantánea
    [current - 1, current + 1].forEach((n) => {
      const next = cards[(n + cards.length) % cards.length];
      if (next.dataset.full) new Image().src = next.dataset.full;
    });
  }

  function open(index: number) {
    lastFocused = document.activeElement as HTMLElement;
    render(index);
    dialog.showModal();
    document.documentElement.style.overflow = "hidden";
  }

  cards.forEach((card, i) => card.addEventListener("click", () => open(i)));

  dialog.querySelectorAll<HTMLButtonElement>(".lb-nav").forEach((btn) =>
    btn.addEventListener("click", () => render(current + Number(btn.dataset.dir))),
  );

  dialog.querySelector(".lb-close")!.addEventListener("click", () => dialog.close());

  // Tocar/clicar fuera de la imagen y los controles cierra el visor
  dialog.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target === dialog || target.classList.contains("lb-content")) dialog.close();
  });

  dialog.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") render(current - 1);
    if (e.key === "ArrowRight") render(current + 1);
  });

  dialog.addEventListener("close", () => {
    document.documentElement.style.overflow = "";
    lastFocused?.focus();
  });

  // Deslizar a izquierda/derecha en móvil para pasar de diploma
  let touchX = 0;
  let touchY = 0;
  dialog.addEventListener(
    "touchstart",
    (e) => {
      touchX = e.touches[0].clientX;
      touchY = e.touches[0].clientY;
    },
    { passive: true },
  );
  dialog.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - touchX;
    const dy = e.changedTouches[0].clientY - touchY;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
      render(current + (dx < 0 ? 1 : -1));
    }
  });
</script>
