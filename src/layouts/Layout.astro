---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Lo que enseñan Google y las redes (WhatsApp, Instagram…) al compartir un
// enlace. `imagen` es una de las tarjetas de /og (ver src/pages/og/).
type Props = {
	titulo?: string;
	descripcion?: string;
	imagen?: string;
};

const MARCA = 'Las Manos de Nanos';
const {
	titulo,
	descripcion = 'Tartas y galletas personalizadas, hechas a mano por Elsa, «Nanos». Mira mis creaciones, algunas en 3D, y prepara tu encargo en un momento.',
	imagen = '/og/inicio.jpg',
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} · ${MARCA}` : `${MARCA} · Tartas y galletas artesanales`;
const url = new URL(Astro.url.pathname, Astro.site);
const imagenUrl = new URL(imagen, Astro.site);
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#BC1150" />
		<meta name="generator" content={Astro.generator} />
		<title>{tituloCompleto}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={url} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={MARCA} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={tituloCompleto} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:image" content={imagenUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={tituloCompleto} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={tituloCompleto} />
		<meta name="twitter:description" content={descripcion} />
		<meta name="twitter:image" content={imagenUrl} />
		<Font cssVariable="--font-nunito" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-pacifico" preload />
		<script is:inline>
			// El <main> se queda oculto hasta que la página está lista para mostrarse
			// de una vez, sin parpadeos:
			// - Las animaciones de entrada ocultan contenido desde JS; si se pinta
			//   antes, se ve aparecer, desaparecer y volver a entrar. Los scripts
			//   de la página corren antes de DOMContentLoaded y GSAP escribe sus
			//   valores iniciales en el siguiente frame.
			// - Al volver atrás sin caché, Safari en iPhone pintaba la página arriba
			//   y luego saltaba a donde estabas. El scroll lo restauramos nosotros
			//   al destapar, con las fuentes ya aplicadas para que la altura cuadre.
			(() => {
				const html = document.documentElement;
				const clave = "scroll:" + location.pathname + location.search;
				html.classList.add("antes-de-js");
				history.scrollRestoration = "manual";
				addEventListener("pagehide", () => {
					try {
						sessionStorage.setItem(clave, String(scrollY));
					} catch {}
				});

				document.addEventListener("DOMContentLoaded", () => {
					const tipo = performance.getEntriesByType("navigation")[0]?.type;
					let y = 0;
					if (tipo === "back_forward" || tipo === "reload") {
						try {
							y = Number(sessionStorage.getItem(clave)) || 0;
						} catch {}
					}
					// No document.fonts.ready: en Safari espera también a imágenes y vídeo
					const fuentes = [...(document.fonts ?? [])]
						.filter((f) => f.status === "loading")
						.map((f) => f.loaded.catch(() => {}));
					const espera = new Promise((listo) => setTimeout(listo, 1000));
					Promise.race([Promise.all(fuentes), espera]).then(() =>
						requestAnimationFrame(() => {
							if (y) scrollTo(0, y);
							html.classList.remove("antes-de-js");
						}),
					);
				});
			})();
		</script>
		<slot name="head" />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
